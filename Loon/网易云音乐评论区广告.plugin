#!name = 网易云音乐评论区去广告
#!desc = 【测试版】移除网易云音乐评论区的广告 \n评论区可能显示为空或加载失败。\n如果遇到问题请停用
#!author = Qingulili by VS Code [https://t.me/Qing_UL]
#!tag = 去广告,网易云音乐
#!type = normal
#!date = 2026-8-5
#!system = iOS,iPadOS
#!system_version = 26
#!loon_version = 3.5.0(975)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NeteaseCloudMusic.png

[Rule]
# 拦截第三方广告 SDK 域名，不过好像没什么用
# DOMAIN-SUFFIX,xinqiucc.com,REJECT

[Rewrite]
# 拦截评论区插入的广告资源（合并接口），返回空响应
^https?:\/\/interface\d?\.music\.163\.com\/xeapi\/comment\/feed\/inserted\/resources\/combined mock-response-body data-type=text data="" status-code=200

[Mitm]
hostname = interface3.music.163.com, interface6.music.163.com
